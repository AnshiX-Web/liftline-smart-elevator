APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_PATH=instance/liftline.sqlite
SEED_DEMO_USERS=1
ESCALATION_MINUTES=2
PUBLIC_BASE_URL=
TRUSTED_PROXY_HOPS=0

# Optional external notifications. In-app notifications work without these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional SMS fallback using a Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MANUAL_EMERGENCY_NUMBER=
